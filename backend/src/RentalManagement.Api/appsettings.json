{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Identity": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Api": {
    "RequireHttps": true
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "DataProtection": {
    "ApplicationName": "RentalManagement.Api",
    "KeyPath": ".local/data-protection-keys"
  }
}
